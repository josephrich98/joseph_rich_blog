#!/usr/bin/env bash
# Regenerate site/_posts from posts/<name>/main.md and stage the results,
# so blog posts authored under posts/ are published on every commit.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

PY=""
for c in python3 python; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  echo "pre-commit: python not found on PATH; skipping post sync" >&2
  exit 0
fi

"$PY" "$ROOT/scripts/sync_posts.py"
git add "$ROOT/site/_posts" "$ROOT/site/images/posts" 2>/dev/null || true
